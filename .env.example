# .env.example
# Copy this file to .env and replace the values with your own.
# WARNING: Never commit the actual .env file containing real API keys or secrets to version control.

# Backend Variables (FastAPI)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Frontend Variables (Next.js)
# Used to connect the Vercel frontend to your hosted Python backend.
# If running locally, you can leave this blank or set to http://localhost:8000
NEXT_PUBLIC_API_URL=https://your-production-backend-url.com